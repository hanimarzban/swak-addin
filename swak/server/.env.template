# SWAK Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Claude API (for AI Insights tools) ───────────────────────────────────
# Get your key from: https://console.anthropic.com
SWAK_CLAUDE_API_KEY=sk-ant-PASTE_YOUR_KEY_HERE

# ── Supabase (for license validation) ────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SWAK_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SWAK_SUPABASE_ANON_KEY=eyJYOUR_ANON_KEY_HERE

# ── Server config (usually no need to change) ─────────────────────────────
SWAK_HOST=127.0.0.1
SWAK_PORT=5000
SWAK_DEBUG=false
